# Project
PROJECT_NAME=vault
PROFILE=generic
CI_PROVIDER=github

# Versions
PHP_VERSION=8.5
MYSQL_VERSION=8.4
# Same compatible versions as the neighbouring PHP 8.5 projects.
XDEBUG_VERSION=3.5.3
COMPOSER_VERSION=2.11.0

# Only the four CORE containers. No DB admin UI or mail collector for a vault.
SERVICES=''
TZ=Europe/Vilnius
PUBLISH_ADDRESS=127.0.0.1
DOCUMENT_ROOT=/
CACHE_MODE=off
XDEBUG_MODE=off

# No application schema exists in the foundation. Enable with the first migration.
DATABASE_AS_CODE=off
