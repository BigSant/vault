{
  "name": "vault/vault",
  "type": "project",
  "require": {
    "php": "^8.5",
    "ext-xmlwriter": "*",
    "bacon/bacon-qr-code": "^3.0",
    "laravel/framework": "^13.17",
    "spomky-labs/otphp": "^11.3"
  },
  "require-dev": {"phpunit/phpunit": "^12.0"},
  "autoload": {"psr-4": {"App\\": "app/"}},
